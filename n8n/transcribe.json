{
  "name": "Transcribe video",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "transcribe-video",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1f1c3b2-0001-4c1e-9a10-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "transcribe-video",
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "x-webhook-secret" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-SITE.example/api/jobs/transcribe",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $('Webhook').item.json.headers['x-webhook-secret'] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ videoId: $('Webhook').item.json.body.videoId }) }}",
        "options": { "timeout": 300000 }
      },
      "id": "a1f1c3b2-0002-4c1e-9a10-000000000002",
      "name": "Run transcribe job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Run transcribe job", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
