# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_ keys are visible in the browser. Everything else is server-only (lib/ and app/api/).

# Clerk — sign in
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — database + video storage (Supabase Auth stays off)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Hugging Face — transcripts + embeddings
HF_TOKEN=

# Pinecone — search by meaning
PINECONE_API_KEY=
PINECONE_INDEX=

# n8n — background jobs (secret header on webhooks)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Facebook Graph API — auto-post (Phase 8a)
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Wire.mn — payments (Phase 8b)
WIRE_API_KEY=
WIRE_WEBHOOK_SECRET=
